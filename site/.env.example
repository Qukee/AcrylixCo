# Database (in Railway, set this to ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://acrylixco:acrylixco_dev@localhost:5432/acrylixco"

# Auth.js v5 (generate AUTH_SECRET with: openssl rand -base64 32)
AUTH_SECRET=""

# Public URL of the deployed app (Auth.js v5)
# In Railway, set this to https://${{RAILWAY_PUBLIC_DOMAIN}}
AUTH_URL="http://localhost:3000"

# Required outside Vercel — Auth.js v5 errors with UntrustedHost without it
AUTH_TRUST_HOST="true"

# Shopify (Phase 3 — headless commerce). Source: Shopify admin → Settings →
# Apps and sales channels → Develop apps → [your custom app] → API credentials.
# - SHOPIFY_STORE_DOMAIN: e.g. acrylixco.myshopify.com (no protocol)
# - SHOPIFY_STOREFRONT_TOKEN: Storefront API access token (public-safe but
#   prefer the NEXT_PUBLIC_ variant when called from client components)
# - NEXT_PUBLIC_SHOPIFY_*: same values, inlined into the client bundle so
#   the Cart API can be called from the browser (cart.checkoutUrl etc.)
# - SHOPIFY_ADMIN_TOKEN: Admin API access token (server-only, never bundle into client code)
# - SHOPIFY_WEBHOOK_SECRET: HMAC signing secret for /api/shopify/webhooks
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_TOKEN=""
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=""
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=""
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
